{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "profiles": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "build_order": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "faction": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "min_attack_wave_size": {
            "minimum": 1,
            "type": "integer"
          },
          "on_ai_tick": {
            "type": "string"
          },
          "personality": {
            "type": "string"
          },
          "preferred_superweapons": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "unit_weights": {
            "additionalProperties": {
              "minimum": 0,
              "type": "integer"
            },
            "type": "object"
          }
        },
        "required": [
          "id",
          "faction"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "profiles"
  ],
  "title": "AiProfileCatalog",
  "type": "object"
}
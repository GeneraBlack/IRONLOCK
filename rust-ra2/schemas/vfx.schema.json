{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ProjectileStyle": {
      "enum": [
        "bullet",
        "laser",
        "tesla",
        "radiation",
        "sonic",
        "mind_control",
        "missile"
      ],
      "type": "string"
    },
    "VfxBlendMode": {
      "enum": [
        "additive",
        "alpha_blend"
      ],
      "type": "string"
    },
    "VfxDecalLinkSpec": {
      "properties": {
        "decal_kind": {
          "type": "string"
        },
        "fade_time_secs": {
          "default": 18.0,
          "format": "float",
          "type": "number"
        },
        "radius": {
          "default": 2.200000047683716,
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "decal_kind"
      ],
      "type": "object"
    },
    "VfxEffectDef": {
      "properties": {
        "camera_shake_intensity": {
          "default": 0.0,
          "format": "float",
          "type": "number"
        },
        "camera_shake_radius": {
          "default": 0.0,
          "format": "float",
          "type": "number"
        },
        "duration_secs": {
          "default": 1.2000000476837158,
          "format": "float",
          "type": "number"
        },
        "emitters": {
          "default": [],
          "items": {
            "$ref": "#/definitions/VfxEmitterDef"
          },
          "type": "array"
        },
        "fallback_style": {
          "allOf": [
            {
              "$ref": "#/definitions/ProjectileStyle"
            }
          ],
          "default": "bullet"
        },
        "ground_decal": {
          "anyOf": [
            {
              "$ref": "#/definitions/VfxDecalLinkSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "looping": {
          "default": false,
          "type": "boolean"
        },
        "name": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "VfxEmitterDef": {
      "properties": {
        "beam_width": {
          "default": 0.0,
          "format": "float",
          "type": "number"
        },
        "blend_mode": {
          "allOf": [
            {
              "$ref": "#/definitions/VfxBlendMode"
            }
          ],
          "default": "additive"
        },
        "burst_count": {
          "default": 0,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "color_ramp_rgba": {
          "default": [
            [
              2.4000000953674316,
              1.399999976158142,
              0.44999998807907104,
              1.0
            ],
            [
              1.2000000476837158,
              0.44999998807907104,
              0.11999999731779099,
              0.699999988079071
            ],
            [
              0.20000000298023224,
              0.20000000298023224,
              0.20000000298023224,
              0.0
            ]
          ],
          "items": {
            "items": {
              "format": "float",
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "cone_angle_deg": {
          "default": 30.0,
          "format": "float",
          "type": "number"
        },
        "continuous_rate_per_sec": {
          "default": 0.0,
          "format": "float",
          "type": "number"
        },
        "drag": {
          "default": 0.0,
          "format": "float",
          "type": "number"
        },
        "duration_secs": {
          "default": 0.800000011920929,
          "format": "float",
          "type": "number"
        },
        "gravity": {
          "default": 0.0,
          "format": "float",
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "lifetime_range_secs": {
          "default": [
            0.3499999940395355,
            0.8500000238418579
          ],
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "local_offset": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "looping": {
          "default": false,
          "type": "boolean"
        },
        "ribbon_width": {
          "default": 0.0,
          "format": "float",
          "type": "number"
        },
        "shape": {
          "allOf": [
            {
              "$ref": "#/definitions/VfxEmitterShape"
            }
          ],
          "default": "sphere"
        },
        "size_ramp": {
          "default": [
            0.20000000298023224,
            0.550000011920929,
            0.05000000074505806
          ],
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "speed_range": {
          "default": [
            2.0,
            6.5
          ],
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "sphere_radius": {
          "default": 0.25,
          "format": "float",
          "type": "number"
        },
        "texture_path": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "VfxEmitterShape": {
      "enum": [
        "point",
        "sphere",
        "cone",
        "ring",
        "beam",
        "ribbon"
      ],
      "type": "string"
    }
  },
  "properties": {
    "effects": {
      "default": [],
      "items": {
        "$ref": "#/definitions/VfxEffectDef"
      },
      "type": "array"
    }
  },
  "title": "VfxCatalog",
  "type": "object"
}

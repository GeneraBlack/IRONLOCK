#!/usr/bin/env python3

import os
import agent

# Ensure persistent Podman volume exists so Restic backups always succeed
agent.run_helper("podman", "volume", "create", "--ignore", "rust-rts-data")

# Repair NODE_ID if an earlier release overwrote NS8's integer cluster node ID
cur_node_id = os.environ.get("NODE_ID", "1")
if not cur_node_id.isdigit():
    if not os.environ.get("RTS_NODE_ID"):
        agent.set_env("RTS_NODE_ID", cur_node_id)
    try:
        rdb = agent.redis_connect()
        real_node_id = rdb.hget("cluster/module_node", os.environ["MODULE_ID"]) or "1"
    except Exception:
        real_node_id = "1"
    agent.set_env("NODE_ID", str(real_node_id))

if not os.environ.get("RTS_NODE_ID"):
    agent.set_env("RTS_NODE_ID", "bls-isp-eu-central-01")

host = os.environ.get("TRAEFIK_HOST") or os.environ.get("HOST") or ""
if host:
    agent.set_env("TRAEFIK_HOST", host)
    agent.set_env("HOST", host)

agent.dump_env()

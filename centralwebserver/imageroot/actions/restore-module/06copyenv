#!/usr/bin/env python3

import json
import sys
import agent

request = json.load(sys.stdin)
original_environment = request.get("environment", {})

for evar in [
    "TRAEFIK_HOST",
    "HOST",
    "TRAEFIK_HTTP2HTTPS",
    "HTTP2HTTPS",
    "TRAEFIK_LETS_ENCRYPT",
    "LETS_ENCRYPT",
    "TTL_SECS",
    "RTS_NODE_ID",
    "RELAY_PORT_START",
    "RELAY_PORT_END",
]:
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])

# Migrate legacy non-integer NODE_ID from older backups into RTS_NODE_ID without touching NODE_ID
legacy_node = original_environment.get("NODE_ID", "")
if legacy_node and not str(legacy_node).isdigit() and "RTS_NODE_ID" not in original_environment:
    agent.set_env("RTS_NODE_ID", str(legacy_node))

# CRITICAL: Flush restored environment variables immediately
agent.dump_env()

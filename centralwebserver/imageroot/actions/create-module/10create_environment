#!/usr/bin/env python3

import os
import re
import agent

# Initialize default environment variables for the module instance.
# IMPORTANT: Never overwrite NODE_ID or TCP_PORT — they are allocated and
# managed by NethServer 8 core (org.nethserver.tcp-ports-demand="1").
module_id = os.environ.get("MODULE_ID", "rust-rts1")
match = re.search(r"(\d+)$", module_id)
instance_num = max(1, int(match.group(1))) if match else 1

# Allocate a dedicated 40-port block (20 relay rooms) per module instance
# so multiple instances on the same NS8 node never collide on host ports.
relay_start = 30100 + (instance_num - 1) * 40
relay_end = relay_start + 39

if not os.environ.get("TCP_PORT"):
    agent.set_env("TCP_PORT", str(20080 + instance_num - 1))

agent.set_env("TRAEFIK_HOST", "")
agent.set_env("HOST", "")
agent.set_env("TRAEFIK_HTTP2HTTPS", "False")
agent.set_env("HTTP2HTTPS", "False")
agent.set_env("TRAEFIK_LETS_ENCRYPT", "False")
agent.set_env("LETS_ENCRYPT", "False")
agent.set_env("TTL_SECS", "45")
agent.set_env("RTS_NODE_ID", f"bls-isp-eu-central-{instance_num:02d}")
agent.set_env("RELAY_PORT_START", str(relay_start))
agent.set_env("RELAY_PORT_END", str(relay_end))

# CRITICAL: Flush environment to ~/.config/state/environment immediately
agent.dump_env()

#!/usr/bin/env python3

import agent

# Initialize default environment variables for the module instance.
# IMPORTANT: Never overwrite NODE_ID — it is reserved by NethServer 8 core
# for the integer cluster node ID (e.g. "1").
agent.set_env("TRAEFIK_HOST", "")
agent.set_env("HOST", "")
agent.set_env("TRAEFIK_HTTP2HTTPS", "True")
agent.set_env("HTTP2HTTPS", "True")
agent.set_env("TRAEFIK_LETS_ENCRYPT", "False")
agent.set_env("LETS_ENCRYPT", "False")
agent.set_env("TTL_SECS", "45")
agent.set_env("RTS_NODE_ID", "bls-isp-eu-central-01")
agent.set_env("RELAY_PORT_START", "30100")
agent.set_env("RELAY_PORT_END", "30139")

# CRITICAL: Flush environment to ~/.config/state/environment immediately
agent.dump_env()

#!/usr/bin/env python3

import os
import agent
import agent.tasks

# Stop and disable the systemd unit
agent.run_helper("systemctl", "--user", "disable", "--now", "rust-rts.service", check=False)

# Remove Traefik HTTP route if registered
traefik_id = agent.resolve_agent_id("traefik@node")
if traefik_id:
    response = agent.tasks.run(
        agent_id=traefik_id,
        action="delete-route",
        data={
            "instance": os.environ["MODULE_ID"],
        },
    )
    agent.assert_exp(response["exit_code"] == 0)

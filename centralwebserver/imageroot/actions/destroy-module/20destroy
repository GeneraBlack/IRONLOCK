#!/usr/bin/env python3

import os
import agent
import agent.tasks

module_id = os.environ.get("MODULE_ID", "rust-rts1")
node_id = os.environ.get("NODE_ID", "1")
if not str(node_id).isdigit():
    node_id = "1"

# Stop and disable the systemd unit
agent.run_helper("systemctl", "--user", "disable", "--now", "rust-rts.service", check=False)

# Remove Reverse-TCP NAT Relay firewall rules from NS8 host node
fw_service = f"{module_id}-relay"
try:
    if hasattr(agent, "remove_public_service"):
        agent.remove_public_service(fw_service)
    else:
        agent.tasks.run(
            agent_id=f"node/{node_id}",
            action="remove-public-service",
            data={"service": fw_service},
        )
except Exception:
    pass

# Remove Traefik HTTP route if registered
traefik_id = agent.resolve_agent_id("traefik@node")
if traefik_id:
    response = agent.tasks.run(
        agent_id=traefik_id,
        action="delete-route",
        data={
            "instance": module_id,
        },
    )
    agent.assert_exp(response["exit_code"] == 0)

#!/usr/bin/env python3

import json
import os
import sys
import agent

request = json.load(sys.stdin)
host = request.get("host", "").strip()
previous_host = (os.environ.get("TRAEFIK_HOST") or os.environ.get("HOST") or "").strip()

errors = []

# Validate Traefik hostname collisions when the domain changes
if host and host != previous_host:
    if agent.http_route_in_use(domain=host):
        errors.append(
            {
                "field": "host",
                "parameter": "host",
                "value": host,
                "error": "domain_already_used_in_traefik",
            }
        )

relay_start = int(request.get("relay_port_start", 30100))
relay_end = int(request.get("relay_port_end", 30139))
if relay_end < relay_start:
    errors.append(
        {
            "field": "relay_port_end",
            "parameter": "relay_port_end",
            "value": relay_end,
            "error": "relay_port_range_invalid",
        }
    )

if errors:
    agent.set_status("validation-failed")
    json.dump(errors, sys.stdout)
    sys.exit(2)
